{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public Loop snapshots; public text is additionally checked by the original import owner",
  "oneOf": [
    {
      "$ref": "#/$defs/v1"
    },
    {
      "$ref": "loop-view-v2.schema.json"
    }
  ],
  "$defs": {
    "v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Public Loop snapshot",
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
              },
              "repository": {
                "type": "string"
              },
              "mode": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "stages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "prompt": {
                      "type": "string"
                    },
                    "input_refs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "output_refs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "consumer_status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "status",
                    "prompt",
                    "input_refs",
                    "output_refs",
                    "consumer_status"
                  ],
                  "additionalProperties": false
                }
              },
              "cards": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
                    },
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "body": {
                      "type": "string"
                    },
                    "source_refs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "title",
                    "body",
                    "source_refs"
                  ],
                  "additionalProperties": false
                }
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
                    },
                    "title": {
                      "type": "string"
                    },
                    "body": {
                      "type": "string"
                    },
                    "source_refs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "body",
                    "source_refs"
                  ],
                  "additionalProperties": false
                }
              },
              "breakpoints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "stage_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "status",
                    "stage_id",
                    "message"
                  ],
                  "additionalProperties": false
                }
              },
              "resources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "label",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "next": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "repository",
              "mode",
              "status",
              "stages",
              "cards",
              "notes",
              "breakpoints",
              "next"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "runs"
      ],
      "additionalProperties": false
    }
  }
}
