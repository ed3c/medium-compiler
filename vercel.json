{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build_site.py",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/transcripts.py": {
      "maxDuration": 60,
      "excludeFiles": "{.git/**,.agents/**,.transcripts/**,vendor/**,evidence/**,tests/**,dist/**,site/**}"
    }
  }
}
