{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "checkout-reliability-sandbox",
  "account_id": "3751568573ab98ef44d3224c418b1c61",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {"crons": []},
  "observability": {"enabled": false},
  "durable_objects": {
    "bindings": [
      {
        "name": "CHECKOUT",
        "class_name": "CheckoutState"
      },
      {
        "name": "PROVIDER",
        "class_name": "ProviderState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CheckoutState",
        "ProviderState"
      ]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PAYMENTS_QUEUE",
        "queue": "checkout-reliability-payments"
      }
    ],
    "consumers": [
      {
        "queue": "checkout-reliability-payments",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 2,
        "dead_letter_queue": "checkout-reliability-dlq"
      }
    ]
  }
}
